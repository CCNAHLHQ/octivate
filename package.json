{
  "name": "octivate",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 4000",
    "build": "next build",
    "start": "node --env-file=.env server/start-app.mjs",
    "lint": "next lint",
    "serve:prod": "node --env-file=.env server/prod.mjs",
    "mail:smtp": "node --env-file=.env server/mail/local-smtp.mjs",
    "mail:dkim": "node --env-file=.env scripts/generate-dkim.mjs",
    "mail:dns": "node --env-file=.env scripts/cloudflare-mail-dns.mjs",
    "dns:origin": "node --env-file=.env scripts/cloudflare-origin-dns.mjs",
    "supabase:bootstrap": "node --env-file=.env scripts/supabase-bootstrap.mjs",
    "supabase:migrate-ops": "node --env-file=.env scripts/supabase-migrate-ops.mjs",
    "supabase:reset-ops-costs": "node --env-file=.env scripts/supabase-reset-ops-costs.mjs",
    "seed:founders": "node --env-file=.env scripts/seed-founders.mjs",
    "certs:selfsigned": "node --env-file=.env scripts/generate-self-signed.mjs",
    "certs:sync": "powershell -ExecutionPolicy Bypass -File scripts/sync-certs.ps1",
    "certs:check": "node scripts/check-certs.mjs",
    "pack:deploy": "powershell -ExecutionPolicy Bypass -File scripts/pack-deploy.ps1",
    "deploy:live": "node --env-file=.env scripts/deploy-live.mjs",
    "ship": "node --env-file=.env scripts/deploy-live.mjs",
    "test:local-evidence": "node --experimental-strip-types --import ./server/parl-ts-register.mjs scripts/test-local-evidence.mjs",
    "test:wales-brief": "node --experimental-strip-types --import ./server/parl-ts-register.mjs scripts/test-wales-brief.mjs",
    "test:pdf-extract": "node --experimental-strip-types --import ./server/parl-ts-register.mjs scripts/test-pdf-extract.mjs",
    "test:parl-queue": "node --experimental-strip-types --import ./server/parl-ts-register.mjs scripts/test-parl-queue.mjs",
    "sources:import": "node scripts/import-source-registry.mjs",
    "export:tokenize": "node scripts/tokenize-export-template.mjs",
    "parl:worker": "node --env-file=.env --experimental-strip-types --import ./server/parl-ts-register.mjs server/parl-media-worker.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "@syntropy-labs/react-web-speech": "^0.1.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "card-validator": "^10.0.4",
    "clsx": "^2.1.1",
    "docx": "^9.7.1",
    "framer-motion": "^11.15.0",
    "hls.js": "^1.7.0",
    "html-to-docx": "^1.8.0",
    "html2canvas": "^1.4.1",
    "http-proxy": "^1.18.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.462.0",
    "mammoth": "^1.12.0",
    "mustache": "^4.2.0",
    "next": "^16.2.10",
    "nodemailer": "^9.0.3",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "plyr": "^3.8.4",
    "pptxgenjs": "^4.0.1",
    "puppeteer-core": "^25.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "recharts": "^2.15.0",
    "sanitize-html": "^2.17.6",
    "selfsigned": "^5.5.0",
    "tailwind-merge": "^2.5.2",
    "yaml": "^2.9.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/card-validator": "^4.1.0",
    "@types/http-proxy": "^1.17.15",
    "@types/leaflet": "^1.9.22",
    "@types/mustache": "^4.2.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/sanitize-html": "^2.16.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8",
    "eslint-config-next": "^16.2.10",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.11",
    "typescript": "^5"
  }
}
