# Public
NEXT_PUBLIC_APP_URL=https://octivate.io
NEXT_PUBLIC_SITE_URL=https://octivate.io

# This host's public IPv4 (used for TLS SAN + Cloudflare origin DNS)
SERVER_PUBLIC_IP=

# Cloudflare — Zone.DNS Edit for octivate.io (npm run dns:origin / mail:dns)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_PROXY=true

# API authentication (required for mutating + /api/operator/*)
OCTIVATE_API_KEY=change-me-to-a-long-random-secret
# Optional dedicated operator key (falls back to OCTIVATE_API_KEY)
OCTIVATE_OPERATOR_KEY=
# Browser demo key (MVP only — rotate / remove once real auth ships)
NEXT_PUBLIC_OCTIVATE_API_KEY=change-me-to-a-long-random-secret

# OpenRouter — live doctrine pipeline only (configure models in Operator → Control)
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=anthropic/claude-sonnet-4.6
OPENROUTER_PREMIUM_MODEL=anthropic/claude-sonnet-4.6
# Used when primary returns empty / soft-fails
OPENROUTER_FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_REASONING_MAX_TOKENS=8192
OPENROUTER_REASONING_BUDGET=2048
OPENROUTER_REASONING_EFFORT=low
OPENROUTER_DOCTRINE_MAX_TOKENS=6000
OPENROUTER_MAX_CONCURRENT=3
OPENROUTER_TIMEOUT_MS=120000
# Set to 1 for verbose per-request OpenRouter JSON logs
OPENROUTER_DEBUG=0

# TLS — relative to repo root; serve:prod auto-creates self-signed if missing
SSL_DOMAIN=octivate.io
SSL_CERT_PATH=certs/octivate.io/fullchain.pem
SSL_KEY_PATH=certs/octivate.io/privkey.pem
SSL_AUTO=true

# Ports — both HTTP and HTTPS serve the app (FORCE_HTTPS=true → redirect :80 → :443)
PORT=443
HTTP_PORT=80
NEXT_PORT=3000
FORCE_HTTPS=false

# Live deploy pipeline (npm run deploy:live / npm run ship)
# Optional GitHub token so the pipeline can push without interactive login
# OCTIVATE_GIT_TOKEN=
# GITHUB_TOKEN=
# DEPLOY_HEALTH_URL=https://octivate.io/api/health
# DEPLOY_GIT_BRANCH=main
# DEPLOY_GIT_NAME=CCNAHLHQ
# DEPLOY_GIT_EMAIL=CCNAHLHQ@users.noreply.github.com

# Parliamentary video ingest (Vimeo / direct MP4 Phase 1)
PARL_MEDIA_ENABLED=true
PARL_MEDIA_ROOT=data/local/parliamentary-videos
PARL_MEDIA_MAX_DISCOVER=40
# Set to 1 to discover only (no download / ASR)
PARL_MEDIA_DRY_RUN=0
# Defaults to CPU cores − 1
# PARL_ASR_CONCURRENCY=
PARL_WHISPER_MODEL=base
# Windows often needs absolute paths (python.exe / Scripts not always on PATH)
# PARL_PYTHON=C:\Python314\python.exe
# YT_DLP_PATH=C:\Python314\Scripts\yt-dlp.exe
# Optional: from `pip install imageio-ffmpeg` (used by yt-dlp merges)
# FFMPEG_PATH=C:\Python314\Lib\site-packages\imageio_ffmpeg\binaries\ffmpeg-win-x86_64-v7.1.exe
PARL_DOMAIN_GAP_MS=800
